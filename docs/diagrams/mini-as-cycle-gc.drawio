<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="循环垃圾回收">
    <mxGraphModel dx="1200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Collect()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="470" y="40" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="3" value="① 快照候选集合&#xa;ScriptObject 创建时已注册" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="160" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="② 统计候选集合内部入边&#xa;internalIncoming[obj]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="290" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="③ 找外部根&#xa;real RefCount &gt; internalIncoming" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="420" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="④ 从外部根做图遍历&#xa;标记所有可达候选对象" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="550" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7" value="存在未标记对象？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="680" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="8" value="⑤ 临时 AddRef&#xa;先给垃圾对象系上安全绳" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="840" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9" value="⑥ ClearReferences&#xa;清空对象字段，主动剪断环" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="970" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="10" value="⑦ Release 临时引用&#xa;回到普通引用计数析构路径" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="1100" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="11" value="返回回收数量 n" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="1230" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="12" value="返回 0&#xa;所有对象仍可达" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="700" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="13" value="关键理解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="300" height="210" as="geometry" />
        </mxCell>
        <mxCell id="14" value="GC 不直接 delete 对象。&#xa;&#xa;它只负责证明“这个环没有外部根”，再剪断对象之间的引用；真正的销毁仍由 ObjectHandle → Release 完成。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="13">
          <mxGeometry x="20" y="45" width="260" height="145" as="geometry" />
        </mxCell>
